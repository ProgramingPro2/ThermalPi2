# udev rule for Seek Thermal Compact / CompactXR (product id 0x0010)
# Copy to /etc/udev/rules.d/ and run: sudo udevadm control --reload-rules
# Then unplug and replug the camera. This allows non-root access to the device.

SUBSYSTEM=="usb", ATTRS{idVendor}=="289d", ATTRS{idProduct}=="0010", MODE="0666", GROUP="users"
